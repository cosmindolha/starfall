# Only the reviewed color game belongs in this repository.
/*
!/.gitignore
!/README.md
!/ASSETS.md
!/main.lua
!/conf.lua
!/Run Starfall.command
!/game/
/game/*
!/game/*.lua
!/tests/
/tests/*
!/tests/*.lua
!/tools/
/tools/*
!/tools/package_game.py
!/tools/install.sh
!/tools/uconsole-launch.sh
!/tools/uconsole-guard.sh
!/tools/starfall-controls-restore.service
!/assets/
/assets/*
!/assets/audio/
/assets/audio/*
!/assets/audio/*.ogg
!/assets/audio/*.wav
!/assets/images/
/assets/images/*
!/assets/images/*.png
!/assets/images/*.lua
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/*.ttf
!/assets/fonts/*LICENSE.txt

# Never commit credentials, local settings, caches, or development leftovers.
.DS_Store
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.*
settings.txt
bindings.txt
__pycache__/
*.pyc
*.log
